# Copy this file to .env and fill in your own values. Never commit .env.

# --- Server ---
PORT=3000
# 127.0.0.1 = only this computer can connect. Use 0.0.0.0 only behind a firewall/reverse proxy.
HOST=127.0.0.1
# Use "production" when deployed behind HTTPS (enables secure cookies and caching).
NODE_ENV=development
# Set to 1 only when running behind exactly one trusted reverse proxy (e.g. Nginx).
TRUST_PROXY=0

# --- Security ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# How long a sign-in lasts without activity (hours).
SESSION_MAX_AGE_HOURS=24
# Failed sign-in / registration attempts allowed per IP every 15 minutes.
AUTH_RATE_LIMIT=10
# API requests allowed per IP per minute.
API_RATE_LIMIT=300
# 1 = log one line per API request (default in development), 0 = off.
# LOG_REQUESTS=1

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=todo_list_management
DB_CONNECTION_LIMIT=10
# 1 = encrypted, certificate-verified connection (needed by Aiven, TiDB Cloud and similar).
# Not needed for Railway's MySQL on its private network.
DB_SSL=0
# Optional: the provider's CA certificate (PEM). Use \n for line breaks on one line.
# DB_SSL_CA=

# --- Production (set these on your host, not in this file) ---
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY=1
# SESSION_SECRET=<new random value, different from development>
# PORT is usually set by the host automatically.
